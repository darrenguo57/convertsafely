# ConvertSafely 生产环境变量模板
# 复制此文件为 .env.production.local 并填入实际值
# 注意: 永远不要将 .env.production.local 提交到版本控制

# ============================================
# Firebase 配置
# 从 Firebase Console > Project Settings > General > Your apps > Web app 获取
# ============================================

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=convertsafely-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=convertsafely-app
VITE_FIREBASE_STORAGE_BUCKET=convertsafely-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Stripe 配置
# 从 Stripe Dashboard > Developers > API keys 获取
# ============================================

# 前端使用的 Publishable Key (以 pk_live_ 或 pk_test_ 开头)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

# 后端使用的 Secret Key (以 sk_live_ 或 sk_test_ 开头)
# 此变量仅用于 Cloud Functions，不会暴露到前端
STRIPE_SECRET_KEY=sk_live_your_secret_key

# Stripe Webhook Secret (从 Stripe Dashboard > Developers > Webhooks 获取)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (从 Stripe Dashboard > Products 获取)
STRIPE_PRO_PRICE_ID=price_your_pro_price_id
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_price_id

# ============================================
# Google AdSense 配置
# 从 Google AdSense 账户获取
# ============================================

VITE_ADSENSE_CLIENT=ca-pub-your_adsense_client_id

# ============================================
# 应用配置
# ============================================

# 应用环境
VITE_APP_ENV=production

# 应用版本
VITE_APP_VERSION=1.0.0

# 支持邮箱
VITE_SUPPORT_EMAIL=support@convertsafely.app

# ============================================
# 功能开关
# ============================================

# 启用/禁用广告
VITE_ENABLE_ADS=true

# 启用/禁用订阅
VITE_ENABLE_SUBSCRIPTION=true

# 启用/禁用用户认证
VITE_ENABLE_AUTH=true

# 最大文件大小限制 (字节)
VITE_MAX_FILE_SIZE=52428800

# ============================================
# 可选: 第三方服务
# ============================================

# Sentry DSN (错误追踪)
# VITE_SENTRY_DSN=https://your_sentry_dsn

# Google Analytics ID
# VITE_GA_ID=G-XXXXXXXXXX
